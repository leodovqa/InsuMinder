{
  "name": "insuminder",
  "version": "1.5.0",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"node server/src/index.js\" \"npm run dev --prefix client\"",
    "build": "npm --prefix client run build",
    "test": "node --test server/test/telegram.test.js server/test/auth.test.js server/test/share.test.js server/test/webpush.test.js server/test/download.test.js server/test/manual-injections.test.js && npm --prefix client test",
    "lint": "npm --prefix client run lint",
    "check:i18n": "npm --prefix client run check:i18n",
    "check:theme": "npm --prefix client run check:theme",
    "check:version": "node scripts/check-version.js",
    "docker": "docker compose up --build",
    "prepare": "husky"
  },
  "dependencies": {
    "moment-timezone": "^0.6.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
